{
  "expo": {
    "name": "VitalQuest",
    "slug": "vitalquest-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vitalquest",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow VitalQuest to verify distance and movement during endurance encounters."
        }
      ],
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "Allow VitalQuest to read workout and heart-rate data to verify completed training.",
          "healthUpdatePermission": false,
          "isBackgroundDeliveryEnabled": false
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitalquestapp.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vitalquestapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/vitalquest-app"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070A"
    }
  }
}